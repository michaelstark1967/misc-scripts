# Example .env for alkira-reports (DO NOT commit real credentials here)

# Alkira API
# ALKIRA_PORTAL should be the tenant portal host (no https), e.g. "tenant.portal.alkira.com"
# You can alternatively set ALKIRA_BASE_URL and the wrapper will use it as ALKIRA_PORTAL.
ALKIRA_PORTAL="your-tenant.portal.alkira.com"
# ALKIRA_API_KEY can be an API key or leave blank to use username/password auth
ALKIRA_API_KEY=""
# or username/password (less preferred)
# ALKIRA_USERNAME="you@example.com"
# ALKIRA_PASSWORD="your-password"

# SMTP settings used by run_aggregate_and_email.sh and delivery config
# These are referenced by alkira_report_config.json via *_env keys.
ALKIRA_SMTP_USERNAME="sender@example.com"
ALKIRA_SMTP_PASSWORD="replace-with-smtp-password-or-app-password"
ALKIRA_REPORT_FROM="sender@example.com"

# Optional Teams webhook URL (if using Teams delivery)
# ALKIRA_TEAMS_WEBHOOK_URL="https://outlook.office.com/webhook/..."

# Optional overrides
# Path to the helper script if not colocated
# ALKIRA_AGGREGATE_BUDGET_SCRIPT="/full/path/to/alkira_aggregate_budget.py"
# Alternate delivery config path
# ALKIRA_REPORT_DELIVERY_CONFIG="/full/path/to/alkira_report_config.json"
